# Newz — canonical environment variables (AGENTS.md §21).
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values may reach browser code; everything else is server-only.
# CRON_SECRET is injected by Vercel on cron requests — do NOT add it to .env.local.

# Clerk — client + server (get values from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk auth route config — client + server
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase — URL + anon key are client + server; service role is server only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Oxylabs Web Scraper API + Scheduler auth — server only
# NOTE: the free RSS+Cheerio pipeline (POST /api/scrape-free,
# GET /api/cron/pipeline-free) needs none of these; they are only for the
# legacy Oxylabs path, which is kept but ignored.
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# Google Gemini — AI analysis (FREE tier, daily reset, no card) — server only
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Shared secret for x-biasly-admin-secret on action routes — server only
BIASLY_ADMIN_SECRET=

# Optional; articles analyzed per batch (default 5) — server only
# ANALYSIS_BATCH_SIZE=5
